{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agentic-mailbox",
	"compatibility_date": "2025-11-28",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"DOMAINS": "hacktivlabs.io,hacktivlabs.com,teraboxx.com,tomiwahq.com,terajournal.com,paprkit.app,orbitreader.app",
		"EMAIL_ADDRESSES": [],
		"ADMIN_HOST": "admin.hacktivlabs.io",
		"PASSKEY_RP_ID": "hacktivlabs.io",
		"PASSKEY_RP_NAME": "Agentic Mailbox"
	},
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "agentic-mailbox-auth",
			"database_id": "replace-with-real-database-id"
		}
	],
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "agentic-mailbox",
			"preview_bucket_name": "agentic-mailbox"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "MAILBOX",
				"class_name": "MailboxDO"
			},
			{
				"name": "EMAIL_AGENT",
				"class_name": "EmailAgent"
			},
			{
				"name": "EMAIL_MCP",
				"class_name": "EmailMCP"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MailboxDO"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"EmailAgent"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"EmailMCP"
			]
		}
	]
}
